# Modèle de configuration — copier en « .env.local » (local) ou saisir dans les variables
# de l'application Node.js chez PlanetHoster (production). Ne jamais versionner les vraies valeurs.

# Connexion MySQL / MariaDB : mysql://utilisateur:motdepasse@hôte:3306/base
DATABASE_URL=mysql://tropicom:MOT_DE_PASSE@127.0.0.1:3306/tropicom

# Dossier où sont enregistrées les images envoyées depuis l'admin (hors du dossier public)
UPLOAD_DIR=./uploads


# E-mails des rendez-vous (facultatif ; sans ces réglages, les rendez-vous sont enregistrés mais aucun e-mail ne part)
# Google Workspace : smtp.gmail.com, port 465, mot de passe d'application du compte
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tropi'Com <admin@tropicomagency.com>"
MAIL_TEAM=admin@tropicomagency.com
